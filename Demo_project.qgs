        <default field="notes" applyOnUpdate="0" expression=""/>
        <default field="L_pitch" applyOnUpdate="0" expression="if( &quot;ObjectGeom&quot; =  'Plane with line' ,&#xd;&#xa;case when &quot;L_plungeAzimuth&quot; - &quot;P_strike&quot; > 180 OR &quot;L_plungeAzimuth&quot; - &quot;P_strike&quot; &lt; 0 THEN null ELSE&#xd;&#xa;(round(&#xd;&#xa; degrees( &#xd;&#xa; atan(&#xd;&#xa;tan( radians( &quot;L_plungeAzimuth&quot; - &quot;P_strike&quot; )) /&#xd;&#xa; cos(radians( &quot;P_dip&quot; ) )&#xd;&#xa; ) &#xd;&#xa; )&#xd;&#xa; ,0)&#xd;&#xa; +180 ) % 180&#xd;&#xa; end,&#xd;&#xa; NULL&#xd;&#xa; )"/>
